{
  "name": "基础能力评测集",
  "description": "用于对比不同模型在任务上的准确率与成本。任务刻意设计成『有唯一正确答案』，这样打分不需要人工判断，评测可以完全自动化、可重复。",
  "tasks": [
    {
      "id": "arith-001",
      "type": "arithmetic",
      "prompt": "计算 12 + 7，只输出数字结果。",
      "expected": "19"
    },
    {
      "id": "arith-002",
      "type": "arithmetic",
      "prompt": "计算 34 + 58，只输出数字结果。",
      "expected": "92"
    },
    {
      "id": "arith-003",
      "type": "arithmetic",
      "prompt": "计算 145 + 267，只输出数字结果。",
      "expected": "412"
    },
    {
      "id": "arith-004",
      "type": "arithmetic",
      "prompt": "计算 1000 - 368，只输出数字结果。",
      "expected": "632"
    },
    {
      "id": "arith-005",
      "type": "arithmetic",
      "prompt": "计算 23 * 7，只输出数字结果。",
      "expected": "161"
    },
    {
      "id": "arith-006",
      "type": "arithmetic",
      "prompt": "计算 256 / 8，只输出数字结果。",
      "expected": "32"
    },
    {
