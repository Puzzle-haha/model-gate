# 复制本文件为 .env 再填真实值。.env 已被 .gitignore 忽略，不会进仓库。
DB_URL=jdbc:mysql://127.0.0.1:3306/model_gate?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Shanghai&characterEncoding=utf8
DB_USER=modelgate_app
DB_PASSWORD=在这里填数据库密码
SERVER_PORT=8081

# 真实供应商密钥。留空则该供应商会被跳过（并在启动日志里说明原因），
# 应用仍能正常启动，只有 MockProvider 和本地假上游可用。
# 注册地址：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=
